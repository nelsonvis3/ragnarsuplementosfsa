# Variables del backend Django. Copiá este archivo como .env.
# En desarrollo se usa SQLite si no definís DATABASE_URL.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
# Imagenes de producto y combos (copiar CLOUDINARY_URL desde la consola de Cloudinary).
CLOUDINARY_URL=
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
PEDIDO_RESERVA_MINUTOS=1440

# En producción: DJANGO_DEBUG=false, clave aleatoria >=50 caracteres, hosts reales,
# FRONTEND_URL=https://tu-dominio, DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-dominio.
# DJANGO_SECURE_SSL_REDIRECT=true requiere HTTPS configurado en el proxy/hosting.
# DJANGO_SECURE_HSTS_SECONDS=0; activar HSTS después de confirmar HTTPS estable.

# Opcional: PostgreSQL. Sin esta variable, Django usa backend/db.sqlite3.
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/ragnar_db

# Mercado Pago: credenciales de prueba mientras desarrollás.
MP_ACCESS_TOKEN=
MP_ENABLED=false
# Secreto de firma de Webhooks, no es el access token.
MP_WEBHOOK_SECRET=
# URL pública HTTPS del endpoint backend/pagos/webhook al desplegar.
MP_WEBHOOK_URL=

# Transferencias manuales a la cuenta Personal Pay. Configurá al menos alias o CVU.
PAGO_ALIAS=
PAGO_CVU=
PAGO_TITULAR=
LOCAL_INSTRUCCIONES=Te contactaremos por WhatsApp para coordinar el pago y el retiro.

# Envíos locales desde Ragnar, Formosa. Sin API key: geocodificación/rutas de OpenStreetMap y FOSS GIS.
# Los servidores públicos son para volúmenes moderados y no ofrecen SLA; las consultas se limitan y cachean.
# Opcional: email de contacto para identificar la app ante los servicios OSM.
OSM_CONTACT_EMAIL=
ENVIO_ORIGEN="Azcuénaga 991, Formosa, Formosa, Argentina"
# Formato: límite en km:precio ARS, separado por comas (hasta 1 km gratis, luego franjas económicas).
ENVIO_TARIFAS_KM_ARS=1:0,3:1000,5:2500,8:3500,12:5000
ENVIO_PAGO_EFECTIVO_INSTRUCCIONES=Te contactaremos para coordinar el envío. Podés pagar en efectivo al recibirlo.

# Correo de confirmación (la imagen usa FRONTEND_URL/logo.png).
# En desarrollo Django imprime el correo en la terminal.
# Para enviar correos reales, descomentá EMAIL_BACKEND y cargá las credenciales SMTP.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Ragnar Suplementos <tu-correo@gmail.com>
